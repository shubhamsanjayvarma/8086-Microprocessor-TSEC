#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "=== Running Pre-Commit Hooks (Strict Mode) ==="

# 1. Run strict linting and formatting checks on staged files
echo "Running lint-staged..."
npx lint-staged || exit 1

# 2. Run full TypeScript type checking across the project
echo "Running strict type check..."
npx tsc --noEmit || exit 1

# 3. Run all tests including security guardrails
echo "Running all tests..."
npm run test || exit 1

echo "=== All checks passed! Proceeding with commit ==="
